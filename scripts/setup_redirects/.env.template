# ─────────────────────────────────────────────────────────────────────────
# Credentials for setup_redirects.py
# Copy this file to ".env" (without the .template), then fill in the values.
# This file MUST stay local — never commit it to git.
# ─────────────────────────────────────────────────────────────────────────

# ── OVH ──────────────────────────────────────────────────────────────────
# How to obtain:
#   1. Go to https://www.ovh.com/auth/api/createToken
#   2. Log in with your OVH account
#   3. Fill the form:
#        Name        : redirection-domaines
#        Description : Setup Netlify redirects for docteursanak.com
#        Validity    : 1 day (you can revoke afterwards)
#        Rights      : add ONE rule for each:
#                       GET     /domain/zone/*
#                       POST    /domain/zone/*
#                       PUT     /domain/zone/*
#                       DELETE  /domain/zone/*
#   4. Submit → you'll see Application Key, Application Secret, Consumer Key
#   5. Paste them below.
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=ovh-eu

# ── Netlify ──────────────────────────────────────────────────────────────
# How to obtain the personal access token:
#   1. Go to https://app.netlify.com/user/applications
#   2. Section "Personal access tokens" → "New access token"
#   3. Name: redirection-domaines, expiration: 7 days
#   4. Click "Generate", copy the token (it's shown only once!)
NETLIFY_TOKEN=

# How to obtain the site ID:
#   1. Go to https://app.netlify.com
#   2. Open the docteursanak site
#   3. Site configuration → General → Site information
#   4. Look for "Site ID" (UUID format: e.g. 12345abc-de67-...)
NETLIFY_SITE_ID=
